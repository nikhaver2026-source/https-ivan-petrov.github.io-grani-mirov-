{
  "name": "gran-mirov",
  "version": "2.0.1",
  "private": true,
  "description": "Грань Миров — полностью озвученная фэнтезийная ролевая игра для незрячих игроков",
  "scripts": {
    "test": "node tests/run.js",
    "test:file": "node tests/run.js --file",
    "serve": "node -e \"const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,r)=>{const u=decodeURIComponent(q.url.split('?')[0]);const t={'.html':'text/html; charset=utf-8','.js':'text/javascript','.json':'application/manifest+json','.png':'image/png','.mp3':'audio/mpeg','.wav':'audio/wav','.flac':'audio/flac'};const fp=p.join(process.cwd(),u==='/'?'index.html':u.slice(1));f.readFile(fp,(e,d)=>{if(e){r.writeHead(404);r.end('404');return;}r.writeHead(200,{'content-type':t[p.extname(fp)]||'application/octet-stream'});r.end(d);});}).listen(8080,()=>console.log('http://127.0.0.1:8080/'))\""
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
