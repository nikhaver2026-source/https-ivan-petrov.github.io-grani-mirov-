<?xml version="1.0" encoding="utf-8"?>
<!-- Сеть игре не нужна: всё лежит внутри приложения, разрешения INTERNET нет.
     VIBRATE — отдача выстрелов, удары, взрывы. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 11+: без этого приложение не видит установленные синтезаторы речи. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- appCategory="game": игра. На планшетах с Android 17 система не отменяет
         поворот экрана, который задаёт игра (инструменты — горизонтально). -->
    <application
        android:label="Подземная лаборатория"
        android:icon="@mipmap/ic_launcher"
        android:appCategory="game"
        android:allowBackup="true"
        android:hasFragileUserData="true"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Lab">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
